{
  "name": "samsung-order-automation",
  "version": "1.0.0",
  "description": "Samsung LATAM SMB QA automation, governance and CI reporting platform",
  "scripts": {
    "auth:open-profile": "node scripts/auth-open-profile.cjs",
    "auth:export": "node scripts/auth-bootstrap.cjs",
    "auth:verify": "node scripts/auth-verify.cjs",
    "auth:open-profile:mx": "node scripts/auth-open-profile-mx.cjs",
    "auth:login:mx": "node scripts/auth-login-mx.cjs",
    "auth:export:mx": "node scripts/auth-bootstrap-mx.cjs",
    "auth:verify:mx": "node scripts/auth-verify-mx.cjs",
    "auth:open-profile:pe": "node scripts/auth-open-profile-pe.cjs",
    "auth:export:pe": "node scripts/auth-bootstrap-pe.cjs",
    "auth:verify:pe": "node scripts/auth-verify-pe.cjs",
    "dst:base-store": "playwright test tests/s2/pe/dst/base-store --project=chromium --workers=1 --grep-invert @destructive",
    "dst:backoffice": "playwright test tests/s2/pe/dst/backoffice --project=chromium --workers=1 --grep-invert \"@destructive|TC73|TC75\"",
    "dst:epp": "playwright test tests/s2/pe/dst/epp --project=chromium --workers=1 --grep-invert @destructive",
    "dst:mx:base-store": "playwright test tests/s1/mx/dst/base-store --project=chromium --workers=1 --grep-invert @destructive",
    "dst:mx:order": "playwright test tests/s1/mx/dst/base-store/order.spec.js --project=chromium --workers=1 --retries=0",
    "dst:mx:list": "playwright test tests/s1/mx/dst/base-store --project=chromium --list --reporter=list",
    "dst:list": "playwright test tests/s2/pe/dst/backoffice tests/s2/pe/dst/base-store tests/s2/pe/dst/epp --project=chromium --list --reporter=list",
    "qst:mx:base-store": "node scripts/run-mx-qst-safe.cjs",
    "qst:mx:list": "node scripts/run-mx-qst-safe.cjs --list",
    "qst:mx:fast": "node scripts/run-mx-qst-fast-guest.cjs",
    "qst:mx:fast:list": "node scripts/run-mx-qst-fast-guest.cjs --list",
    "qst:pe:p1": "node scripts/run-pe-qst-p1.cjs",
    "qst:pe:p1:list": "node scripts/run-pe-qst-p1.cjs --list",
    "qst:pe:base-store": "playwright test tests/s1/pe/qst/base-store --project=chromium --workers=1 --grep-invert @destructive",
    "qst:pe:list": "playwright test tests/s1/pe/qst/base-store --project=chromium --list --reporter=list",
    "qst:pe:progress": "node scripts/print-pe-qst-progress.cjs",
    "qst:pe:legacy:normal": "node scripts/qst-run.cjs normal",
    "qst:pe:legacy:modified": "node scripts/qst-run.cjs modified",
    "qst:pe:legacy:sanity": "node scripts/qst-run.cjs sanity",
    "qst:pe:legacy:base-store": "node scripts/qst-run.cjs normal base-store",
    "qst:pe:legacy:epp": "node scripts/qst-run.cjs normal epp",
    "qst:pe:legacy:list": "playwright test tests/s2/pe/qst --project=chromium --list --reporter=list",
    "qst:normal": "npm run qst:pe:legacy:normal",
    "qst:modified": "npm run qst:pe:legacy:modified",
    "qst:sanity": "npm run qst:pe:legacy:sanity",
    "qst:base-store": "npm run qst:pe:legacy:base-store",
    "qst:epp": "npm run qst:pe:legacy:epp",
    "qst:list": "npm run qst:pe:legacy:list",
    "qst:smb:basic": "playwright test tests/s1/smb/qst/base-store/basic-storefront.spec.js --project=chromium --workers=1",
    "qst:smb:basic:list": "playwright test tests/s1/smb/qst/base-store/basic-storefront.spec.js --project=chromium --list --reporter=list",
    "qst:smb:backoffice": "playwright test tests/s1/smb/qst/backoffice --project=chromium --workers=1",
    "qst:shared:candidates": "node scripts/print-qst-shared-candidates.cjs",
    "qst:metadata:drift": "node scripts/print-qst-metadata-drift.cjs",
    "qst:metadata:drift:test": "node --test mapping-tests/qstMetadataDrift.test.cjs",
    "qst:implementation": "node scripts/print-qst-implementation.cjs",
    "qst:mapping:validate": "node scripts/validate-qst-mapping.cjs",
    "qst:cycle:status": "node scripts/print-smb-cycle-status.cjs",
    "qst:cycle:status:json": "node scripts/print-smb-cycle-status.cjs --json",
    "qst:cycle:inventory:json": "node scripts/print-official-smb-inventory.cjs",
    "qst:cycle:reuse:json": "node scripts/print-official-smb-reuse.cjs",
    "qst:reconcile:legacy:mx": "node scripts/print-mx-legacy-reconciliation.cjs",
    "qst:reconcile:legacy": "node scripts/print-legacy-reconciliation.cjs",
    "qst:official:gate": "node scripts/validate-official-smb.cjs",
    "preqa2:config:test": "node --test mapping-tests/preqa2Config.test.cjs",
    "preqa2:validation:test": "node --test mapping-tests/*.test.cjs",
    "preqa2:plan": "node scripts/print-preqa2-campaign.cjs",
    "preqa2:plan:mx": "node scripts/print-preqa2-campaign.cjs MX",
    "preqa2:closure": "node scripts/print-preqa2-closure.cjs",
    "preqa2:closure:mx": "node scripts/print-preqa2-closure.cjs MX",
    "preqa2:promotions": "node scripts/print-preqa2-promotions.cjs",
    "preqa2:reconcile": "node scripts/print-preqa2-reconciliation.cjs",
    "preqa2:record": "node scripts/record-preqa2-result.cjs",
    "preqa2:bootstrap": "node scripts/preqa2-bootstrap.cjs",
    "preqa2:gate": "node scripts/preqa2-gate.cjs && npm run preqa2:validation:test && npm run reporting:preqa2:test",
    "reporting:evidence:test": "node --test reporters/tests/evidence.test.cjs && playwright test --config=reporters/tests/playwright.evidence.config.cjs",
    "reporting:executive": "node reporters/executive/generateExecutiveReport.cjs",
    "reporting:executive:test": "node --test reporters/tests/executive.test.cjs",
    "reporting:mx-runtime:test": "node --test reporters/tests/mxQstRuntimeSummary.test.cjs reporters/tests/executiveV3.test.cjs reporters/tests/listIsolation.test.cjs reporters/tests/allureIntegration.test.cjs",
    "reporting:mx:preview": "node scripts/preview-mx-dashboard.cjs",
    "reporting:allure:install": "npm install --no-save --package-lock=false --ignore-scripts allure-playwright@3.11.1 allure-commandline@2.43.0",
    "reporting:allure:smoke": "node scripts/run-allure-smoke.cjs",
    "reporting:preqa2": "node reporters/preqa2/generatePreqa2Report.cjs",
    "reporting:preqa2:status": "node reporters/preqa2/generatePreqa2Status.cjs",
    "reporting:preqa2:test": "node --test reporters/tests/preqa2Executive.test.cjs reporters/tests/preqa2Status.test.cjs",
    "reporting:all": "npm run reporting:evidence:test && npm run reporting:executive:test && npm run reporting:preqa2:test && npm run reporting:executive && npm run reporting:preqa2 && npm run reporting:preqa2:status",
    "preqa2:validate:safe": "node scripts/preqa2-safe-validation.cjs"
  },
  "keywords": [
    "playwright",
    "qa",
    "samsung",
    "sap-commerce"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1"
  }
}
