{
  "name": "samsung-order-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "auth:open-profile": "node scripts/auth-open-profile.cjs",
    "auth:export": "node scripts/auth-bootstrap.cjs",
    "auth:verify": "node scripts/auth-verify.cjs",
    "auth:open-profile:mx": "node scripts/auth-open-profile-mx.cjs",
    "auth:export:mx": "node scripts/auth-bootstrap-mx.cjs",
    "auth:verify:mx": "node scripts/auth-verify-mx.cjs",
    "dst:base-store": "playwright test tests/s2/pe/dst/base-store --project=chromium --workers=1 --grep-invert @destructive",
    "dst:backoffice": "playwright test tests/s2/pe/dst/backoffice --project=chromium --workers=1 --grep-invert \"@destructive|TC73|TC75\"",
    "dst:epp": "playwright test tests/s2/pe/dst/epp --project=chromium --workers=1 --grep-invert @destructive",
    "dst:mx:base-store": "playwright test tests/s1/mx/dst/base-store --project=chromium --workers=1 --grep-invert @destructive",
    "dst:mx:order": "playwright test tests/s1/mx/dst/base-store/order.spec.js --project=chromium --workers=1 --retries=0",
    "dst:mx:list": "playwright test tests/s1/mx/dst/base-store --project=chromium --list",
    "dst:list": "playwright test tests/s2/pe/dst/backoffice tests/s2/pe/dst/base-store tests/s2/pe/dst/epp --project=chromium --list",
    "qst:normal": "node scripts/qst-run.cjs normal",
    "qst:modified": "node scripts/qst-run.cjs modified",
    "qst:sanity": "node scripts/qst-run.cjs sanity",
    "qst:base-store": "node scripts/qst-run.cjs normal base-store",
    "qst:epp": "node scripts/qst-run.cjs normal epp",
    "qst:list": "playwright test tests/s2/pe/qst --project=chromium --list",
    "qst:mx:base-store": "playwright test tests/s1/mx/qst/base-store --project=chromium --workers=1 --grep-invert @destructive",
    "qst:mx:list": "playwright test tests/s1/mx/qst/base-store --project=chromium --list"
  },
