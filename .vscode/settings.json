{
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/allure-report": true,
    "**/allure-results": true,
    "**/playwright/.auth": true,
    "tests/s1": true,
    "tests/s2": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/allure-report": true,
    "**/allure-results": true,
    "**/playwright/.auth": true,
    "tests/s1": true,
    "tests/s2": true
  }
}
